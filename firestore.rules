rules_version = '2';

// ===============================================================
// CIPHER//VAULT - Zero-Knowledge Firestore Security Rules
// ===============================================================
//
// Structure:
// 1. users/{userId}
//    - Email ID, login metadata, PBKDF2 salt, and auth hash verifier.
//
// 2. users/{userId}/credentials/{credentialId}
//    - Individual credential entries stored per account.
//    - Encrypted client-side with AES-256-GCM.
//
// 3. vaults/{userId}
//    - Complete encrypted backup bundle (for atomic restore/sync).
//
// Zero-Knowledge Guarantee:
// Every read/write requires request.auth.uid == userId.
// Plaintext passwords NEVER leave the client browser.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User login profile and account document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Individual credentials stored per account
      match /credentials/{credentialId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Monolithic vault bundle collection (cached backup)
    match /vaults/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
