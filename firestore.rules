rules_version = '2';

// ===============================================================
// CIPHER//VAULT - Zero-Knowledge Hardened Firestore Security Rules
// ===============================================================
//
// Zero-Knowledge Guarantee:
// 1. Strict Owner Verification: Every read and write requires request.auth.uid == userId.
// 2. Strict Type Safety & Size Limits: Defends against storage exhaustion, DoS, and malformed writes.
// 3. No Plaintext Credential Fields: Only encrypted ciphertexts, IVs, and salts are stored.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation for user metadata document: users/{userId}
    function isValidUserDoc(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.email is string && data.email.size() <= 200
        && data.lastLoginAt is number
        && (!('authHash' in data) || (data.authHash is string && data.authHash.size() <= 128))
        && (!('salt' in data) || (data.salt is string && data.salt.size() <= 64))
        && (!('totpEnabled' in data) || (data.totpEnabled is bool))
        && (!('totpSecret' in data) || (data.totpSecret is string && data.totpSecret.size() <= 128))
        && (!('totpConfiguredAt' in data) || (data.totpConfiguredAt is number));
    }

    // Validation for individual encrypted credential: users/{userId}/credentials/{credentialId}
    function isValidCredentialDoc(credentialId) {
      let data = request.resource.data;
      return data.id is string && data.id == credentialId && data.id.size() <= 100
        && data.iv is string && data.iv.size() <= 64
        && data.ciphertext is string && data.ciphertext.size() <= 65536
        && data.updatedAt is number;
    }

    // Validation for monolithic encrypted vault bundle: vaults/{userId}
    function isValidVaultBundle() {
      let data = request.resource.data;
      return data.version is number
        && data.salt is string && data.salt.size() <= 64
        && data.authHash is string && data.authHash.size() <= 128
        && data.iv is string && data.iv.size() <= 64
        && data.ciphertext is string && data.ciphertext.size() <= 1048576
        && data.updatedAt is number;
    }

    // User login profile and account document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserDoc(userId);
      allow delete: if isOwner(userId);

      // Individual encrypted credentials stored per account
      match /credentials/{credentialId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCredentialDoc(credentialId);
        allow delete: if isOwner(userId);
      }
    }

    // Monolithic vault bundle collection (cached backup)
    match /vaults/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidVaultBundle();
      allow delete: if isOwner(userId);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
